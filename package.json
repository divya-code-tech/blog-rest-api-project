{
  "name": "blog-rest-api-project",
  "version": "1.0.0",
  "description": "A secure Blog REST API built with Node.js, Express, MongoDB, JWT authentication, request validation, pagination, search, and Swagger documentation.",
  "main": "src/server.js",
  "scripts": {
    "test": "jest --runInBand --testTimeout=20000",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:coverage": "jest --runInBand --coverage --testTimeout=20000"
  },
  "keywords": [
     "blog",
     "rest-api",
     "nodejs",
     "express",
     "mongodb",
     "mongoose",
     "jwt",
     "jest",
    "swagger"
  ],
  "author": "Divya",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.12.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
